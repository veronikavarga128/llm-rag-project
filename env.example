# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=corpus

# --- Embedding ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Generáló LLM (OpenAI-kompatibilis végpont) ---
# Ollama (helyi):  
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# Hosztolt API:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# --- Retrieval alapértékek ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
